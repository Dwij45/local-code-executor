# Shared secret. Algora sends the same value as EXECUTOR_TOKEN (Authorization header).
RUNNER_TOKEN=dev-secret

HOST=127.0.0.1
PORT=2000

# Job image (amd64 on this PC; pull arm64 on Ampere later)
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:22-slim
GCC_IMAGE=gcc:14
JAVA_IMAGE=eclipse-temurin:21-jdk

MAX_SOURCE_CHARS=10000
MAX_RUN_TIMEOUT_MS=10000
MAX_COMPILE_TIMEOUT_MS=10000
MAX_STDOUT_BYTES=65536

# A4 isolation (job container only)
# ISOLATION_MEMORY_MB=128
# ISOLATION_PIDS_LIMIT=64
# ISOLATION_TMPFS_SIZE=32m
# ISOLATION_LOG_MAX_SIZE=64k

# Leave temp job folders on disk so you can open main.py (default: delete after the job)
# RUNNER_KEEP_WORK=1
