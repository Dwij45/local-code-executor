{
  "name": "algora-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "check:a3": "node --env-file=.env scripts/check-a3-contract.mjs",
    "check:a4": "node --env-file=.env scripts/check-a4-isolation.mjs",
    "check:a5": "node --env-file=.env scripts/check-a5-javascript.mjs",
    "check:a6": "node --env-file=.env scripts/check-a6-cpp.mjs",
    "check:a7": "node --env-file=.env scripts/check-a7-java.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "dockerode": "^4.0.7",
    "hono": "^4.9.8"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.44",
    "@types/node": "^22.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
